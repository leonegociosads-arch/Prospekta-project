# ============================================================
#  Prospekta - modelo de variaveis de ambiente
#  Copie este arquivo para .env.local e preencha os valores.
#  O .env.local NUNCA vai para o Git.
# ============================================================

# --- Google Cloud: 1 chave para as 3 APIs ---
# Places API (New) + Geocoding API + PageSpeed Insights API
# Criada no Anexo A do plano (docs/prospekta-plano.html).
GOOGLE_MAPS_API_KEY=

# --- Supabase ---
# Project Settings -> API
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=
# Chave "anon" / "publishable" (pode ir para o navegador):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" / "secret" (NUNCA no navegador - so servidor/worker):
SUPABASE_SERVICE_ROLE_KEY=

# --- Guardas de custo (opcional - tem defaults no codigo) ---
# Todo valor abaixo e limitado a uma faixa segura: se voce colocar algo fora
# dela (ex.: TTL 0, teto gigante), o codigo ajusta e a tela /config avisa.
PROSPEKTA_TETO_MENSAL_CHAMADAS=2000        # faixa: 1 a 50000
PROSPEKTA_CACHE_TTL_BUSCA_DIAS=60          # faixa: 1 a 365 dias
PROSPEKTA_CACHE_TTL_DETALHES_DIAS=30       # faixa: 1 a 365 dias
# Nao reanalisa o site de um lead antes de X dias:
PROSPEKTA_CACHE_TTL_SITE_DIAS=14           # faixa: 1 a 365 dias
PROSPEKTA_CACHE_TTL_SOCIAL_DIAS=30         # faixa: 1 a 365 dias
PROSPEKTA_CACHE_TTL_ADS_DIAS=21            # faixa: 1 a 365 dias (indicios de anuncio)
# PageSpeed na analise de site (lento e com cota). Vazio/0 = desligado.
# Ligue com: PROSPEKTA_PAGESPEED=1
PROSPEKTA_PAGESPEED=

# --- Meta Ad Library (etapa 12 - indicios de anuncio) ---
# OPCIONAL. Sem este token, o veredito de anuncios vem SO dos sinais do site.
# Token de app do Facebook for Developers (developers.facebook.com). A API
# oficial cobre pouco do comercio no Brasil - o resultado costuma ser
# "desconhecido". So servidor/worker usam.
META_AD_LIBRARY_TOKEN=

# --- IA: diagnostico comercial (etapa 14) ---
# Chave do Google AI Studio (aistudio.google.com/apikey). E uma chave SEPARADA
# da GOOGLE_MAPS_API_KEY - nao reutilize. So o servidor/worker usam.
GEMINI_API_KEY=

# Ajustes do diagnostico (todos opcionais - tem default no codigo):
# Modelo (gemini-2.0-flash e o padrao e o mais barato):
PROSPEKTA_IA_MODELO=gemini-2.0-flash
# Score minimo para o lead entrar no diagnostico em lote:
PROSPEKTA_IA_SCORE_MINIMO=70               # faixa: 0 a 100
# Alem do score minimo, os N melhores de cada pesquisa sempre entram:
PROSPEKTA_IA_TOP_N=5                       # faixa: 0 a 50
# Teto DURO de gasto com IA no mes (USD). Ao atingir, bloqueia novas chamadas.
# 0 = IA desligada. Nao adianta colocar mais que 25 (limite de seguranca).
PROSPEKTA_IA_TETO_MENSAL_USD=5             # faixa: 0 a 25
# Nao refaz o diagnostico de um lead antes de X dias (se os dados nao mudaram):
PROSPEKTA_IA_TTL_DIAS=30                   # faixa: 1 a 365 dias
# Temperatura do modelo (0 = mais previsivel):
PROSPEKTA_IA_TEMPERATURA=0                 # faixa: 0 a 2
