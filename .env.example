# ============================================================
#  Prospekta - modelo de variaveis de ambiente
#  Copie este arquivo para .env.local e preencha os valores.
#  O .env.local NUNCA vai para o Git.
# ============================================================

# --- Google Cloud: 1 chave para as 3 APIs ---
# Places API (New) + Geocoding API + PageSpeed Insights API
# Criada no Anexo A do plano (docs/prospekta-plano.html).
GOOGLE_MAPS_API_KEY=

# --- Supabase ---
# Project Settings -> API
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=
# Chave "anon" / "publishable" (pode ir para o navegador):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" / "secret" (NUNCA no navegador - so servidor/worker):
SUPABASE_SERVICE_ROLE_KEY=

# --- Guardas de custo (opcional - tem defaults no codigo) ---
PROSPEKTA_TETO_MENSAL_CHAMADAS=2000
PROSPEKTA_CACHE_TTL_BUSCA_DIAS=60
PROSPEKTA_CACHE_TTL_DETALHES_DIAS=30

# --- IA (so na etapa de diagnostico) ---
# Escolha um provedor e deixe os outros em branco.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
